{
  "id": "io.github.tariqaq.morpheus",
  "name": "Morpheus",
  "description": "A board dashboard that morphs to what you are doing on the PC: media, games, calls",
  "version": "0.1.0",
  "min_fenixos": "0.1.13",
  "color": "purple",
  "icon": "shapes",
  "repo": "https://github.com/tariqaq/morpheus",
  "board": {},
  "pc": { "elevated": false },
  "permissions": [],
  "settings": [
    { "key": "greeting", "type": "text", "label": "Greeting", "default": "Seconds counted on your PC", "max_len": 40 },
    { "key": "step", "type": "choice", "label": "Count every", "default": "1", "options": [
      { "value": "1", "label": "1 s" }, { "value": "2", "label": "2 s" }, { "value": "5", "label": "5 s" } ] }
  ]
}
